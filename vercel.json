{
  "builds": [
    {
      "src": "front-end/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "^/$",
      "dest": "/front-end/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/([^/]+)\\.html",
      "dest": "/front-end/$1.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/([^/]+)/",
      "dest": "/front-end/$1",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/([^/]+)",
      "dest": "/front-end/$1.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/front-end/$1",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}