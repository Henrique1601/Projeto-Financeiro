{
  "builds": [
    {
      "src": "front-end/**",
      "use": "@vercel/static"
    },
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "backend/api/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/front-end/$1",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}